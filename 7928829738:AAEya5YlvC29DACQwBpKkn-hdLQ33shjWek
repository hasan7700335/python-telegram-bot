from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import (
    ApplicationBuilder CommandHandler, MessageHandler, ContextTypes, CallbackQueryHandler, filters
)
import re

TOKEN =7928829738:AAEya5YlvC29DACQwBpKkn-hdLQ33shjWek

# 🔞 فهرست فحش‌ها
bad_words = ["فحش", "ناسزا", "کلمه_بد", "توپ"]


# ✅ فیلتر پیام‌ها (فحش + لینک)
async def filter_messages(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = update.message.text.lower()

    # فیلتر فحش
    if any(word in text for word in bad_words):
        await update.message.delete()
        await update.message.reply_text("⚠️ لطفاً مودب باش!")

    # فیلتر لینک
    elif "http" in text or "t.me" in text or re.search(r"(https?://\S+)", text):
        await update.message.delete()
        await update.message.reply_text("🚫 ارسال لینک ممنوعه!")


# 📢 تبلیغ در پیام‌های معمولی
async def advertise(update: Update, context: ContextTypes.DEFAULT_TYPE):
    keyboard = [
        [InlineKeyboardButton("📌 بیو رو پر کن", url="https://t.me/yourchannel")],
        [InlineKeyboardButton("👥 فالو کن", url="https://t.me/yourgroup")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    await update.message.reply_text("📢 بیو رو پر کن و عضوهای دیگه رو فالو کن! 👇", reply_markup=reply_markup)


# 👋 خوش‌آمدگویی
async def welcome(update: Update, context: ContextTypes.DEFAULT_TYPE):
    for user in update.message.new_chat_members:
        await update.message.reply_text(f"سلام {user.first_name} 🌟 به گروه خوش اومدی!")


# 🆘 help command
async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    keyboard = [
        [InlineKeyboardButton("📜 قوانین", callback_data='rules')],
        [InlineKeyboardButton("💬 ارتباط با ادمین", url="https://t.me/your_admin_username")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    await update.message.reply_text("چطور می‌تونم کمکت کنم؟ 👇", reply_markup=reply_markup)


# 📌 دکمه قوانین
async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    if query.data == 'rules':
        await query.edit_message_text("📜 قوانین گروه:\n1. بی‌احترامی ممنوع\n2. لینک ممنوع\n3. لطفاً بیو پر کنید")


# 🚀 اجرای ربات
app = ApplicationBuilder().token(TOKEN).build()

app.add_handler(CommandHandler("help", help_command))
app.add_handler(CallbackQueryHandler(button_handler))
app.add_handler(MessageHandler(filters.StatusUpdate.NEW_CHAT_MEMBERS, welcome))
app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, filter_messages))
app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, advertise))

print("🤖 ربات فعال شد...")
app.run_polling()
